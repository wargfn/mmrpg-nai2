[open_webui]
# Host for Open WebUI API
host = "http://127.0.0.1:3000"
# Optional OpenAI/OpenWebUI-compatible base URL override
# base_url = "http://127.0.0.1:11434/v1"

# Default model used by the CLI if --model is not passed
model = "qwen2.5:14b-instruct"

# Optional API key used as Authorization header when set
api_key = ""

# Optional HTTP timeout in seconds for chat requests
# timeout = 120

# Preferred LLM timeout in milliseconds for CLI and Discord requests
llm_timeout_ms = 220

[discord]
# Preferred command prefix for text commands
command_prefix = "!"
# Designated campaign channel id for freeform narration; replies in matching threads are also allowed
# campaign_channel_id = 123456789012345678
# Optional maximum stored messages per channel history (excluding system prompt)
# history_limit = 24
# Discord bot token (prefer NARRATOR_DISCORD_BOT_TOKEN; DISCORD_BOT_TOKEN is also supported)
# token = ""
